# Copy this file to .env on the deployment host and replace secrets.
POSTGRES_DB=email_campaign_db
DB_USERNAME=postgres
DB_PASSWORD=replace-with-strong-db-password
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-strong-admin-password
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRATION_MINUTES=60
KAFKA_CONSUMER_GROUP=email-campaign-ops
KAFKA_TOPIC=campaign-events
